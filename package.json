{
  "name": "flowarc",
  "private": true,
  "version": "0.1.0",
  "description": "FlowArc — Programmable financial infrastructure for organizations.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @flowarc/web",
    "build": "npm run build -w @flowarc/web",
    "start": "npm run start -w @flowarc/web",
    "lint": "npm run lint -w @flowarc/web",
    "typecheck": "npm run typecheck -w @flowarc/web",
    "test": "npm run test -w @flowarc/web",
    "test:e2e": "npm run test:e2e -w @flowarc/web",
    "db:generate": "npm run db:generate -w @flowarc/web",
    "db:push": "npm run db:push -w @flowarc/web",
    "db:migrate": "npm run db:migrate -w @flowarc/web",
    "db:seed": "npm run db:seed -w @flowarc/web",
    "db:studio": "npm run db:studio -w @flowarc/web",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11"
  },
  "engines": {
    "node": ">=20"
  }
}

# ─── App ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Demo auth (local without Supabase). Set to "true" for hackathon demo.
DEMO_AUTH_ENABLED=true
# Optional: pin demo password for staff login (default remains tableos-demo for compatibility)
DEMO_STAFF_PASSWORD=tableos-demo

# ─── Database (Postgres via docker compose) ────────────
DATABASE_URL=postgresql://tableos:tableos@localhost:5433/tableos?schema=public

# ─── Supabase (optional — when DEMO_AUTH_ENABLED=false) ─
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── AI (OpenAI) — optional; graceful fallback without key ─
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_ENABLED=true

# ─── Payments ──────────────────────────────────────────
# mock | arc
PAYMENTS_ADAPTER=mock
# Arc adapter scaffold (not live unless you wire RPC + contracts)
ARC_RPC_URL=
ARC_USDC_ADDRESS=
ARC_ESCROW_ADDRESS=
ARC_CHAIN_ID=

# ─── Observability stubs ───────────────────────────────
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

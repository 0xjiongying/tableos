{
  "$schema": "https://tableos.local/design-tokens.schema.json",
  "meta": {
    "name": "TableOS Luxury Japanese Hospitality",
    "version": "1.0.0",
    "updated": "2026-07-22",
    "philosophy": "Calm confidence, Omotenashi, quiet technology. Bright matte surfaces. Soft tonal elevation — never drop-shadow SaaS.",
    "typeface": {
      "primary": "Geist",
      "mono": "Geist Mono",
      "rationale": "Refined geometric sans with excellent UI metrics; more editorial presence than Inter without sacrificing readability. Avoids Inter/startup cliché while remaining production-ready."
    }
  },
  "color": {
    "primitive": {
      "warmIvory": { "hex": "#F7F3EB", "oklch": "oklch(0.961 0.012 95)" },
      "riceWhite": { "hex": "#FAF8F4", "oklch": "oklch(0.978 0.008 95)" },
      "softPearl": { "hex": "#F3EFE8", "oklch": "oklch(0.948 0.010 90)" },
      "mistWhite": { "hex": "#F9F7F4", "oklch": "oklch(0.975 0.006 90)" },
      "naturalLinen": { "hex": "#EDE6DB", "oklch": "oklch(0.928 0.015 90)" },
      "lightSand": { "hex": "#E8DFD0", "oklch": "oklch(0.908 0.020 85)" },
      "warmStone": { "hex": "#D4CBC0", "oklch": "oklch(0.848 0.015 80)" },
      "ashGray": { "hex": "#B8B0A6", "oklch": "oklch(0.748 0.012 80)" },
      "paleTaupe": { "hex": "#C9BDB0", "oklch": "oklch(0.798 0.020 70)" },
      "softClay": { "hex": "#C4A99A", "oklch": "oklch(0.758 0.030 55)" },
      "sage": { "hex": "#8B9A7D", "oklch": "oklch(0.658 0.040 130)" },
      "bamboo": { "hex": "#A8B89A", "oklch": "oklch(0.748 0.040 125)" },
      "matcha": { "hex": "#6B7F5A", "oklch": "oklch(0.548 0.060 130)" },
      "moss": { "hex": "#5A6B4F", "oklch": "oklch(0.478 0.050 135)" },
      "deepForest": { "hex": "#3D4A38", "oklch": "oklch(0.348 0.035 140)" },
      "champagneGold": { "hex": "#C4B08A", "oklch": "oklch(0.758 0.040 85)" },
      "brushedBrass": { "hex": "#A8926C", "oklch": "oklch(0.678 0.050 80)" },
      "warmBronze": { "hex": "#8B7355", "oklch": "oklch(0.548 0.040 75)" },
      "inkBlack": { "hex": "#1A1917", "oklch": "oklch(0.198 0.008 85)" },
      "charcoal": { "hex": "#2C2A26", "oklch": "oklch(0.278 0.010 85)" },
      "warmGray": { "hex": "#6B6560", "oklch": "oklch(0.498 0.010 70)" },
      "mutedGray": { "hex": "#8A837C", "oklch": "oklch(0.598 0.010 70)" },
      "danger": { "hex": "#8F4E3C", "oklch": "oklch(0.480 0.080 35)" }
    },
    "semantic": {
      "bg": "riceWhite",
      "bgSubtle": "warmIvory",
      "bgMuted": "softPearl",
      "surface": "mistWhite",
      "surfaceRaised": "warmIvory",
      "surfaceSunken": "naturalLinen",
      "borderSubtle": "lightSand",
      "border": "warmStone",
      "borderStrong": "ashGray",
      "borderFocus": "deepForest",
      "borderAccent": "champagneGold",
      "text": "charcoal",
      "textStrong": "inkBlack",
      "textMuted": "warmGray",
      "textFaint": "mutedGray",
      "textOnAccent": "riceWhite",
      "accent": "deepForest",
      "accentHover": "moss",
      "accentMuted": "matcha",
      "premium": "brushedBrass",
      "premiumSoft": "champagneGold",
      "success": "moss",
      "warn": "warmBronze",
      "danger": "danger",
      "info": "charcoal"
    },
    "contrastPolicy": {
      "standard": "WCAG AA minimum on all text tokens vs intended backgrounds",
      "bodyText": "charcoal or inkBlack on riceWhite / warmIvory / mistWhite",
      "mutedText": "warmGray only on riceWhite-family; never champagneGold as body text",
      "accentButtons": "riceWhite on deepForest (primary); charcoal on bamboo soft fills",
      "status": "Never color alone — pair with label/icon"
    }
  },
  "typography": {
    "families": {
      "sans": "Geist",
      "mono": "Geist Mono"
    },
    "scale": {
      "display": { "size": "40px", "weight": 500, "lineHeight": 1.2, "tracking": "-0.02em" },
      "title": { "size": "28px", "weight": 500, "lineHeight": 1.25, "tracking": "-0.015em" },
      "heading": { "size": "20px", "weight": 500, "lineHeight": 1.35, "tracking": "-0.01em" },
      "body": { "size": "16px", "weight": 400, "lineHeight": 1.6, "tracking": "0" },
      "bodySm": { "size": "14px", "weight": 400, "lineHeight": 1.55, "tracking": "0" },
      "caption": { "size": "12px", "weight": 500, "lineHeight": 1.45, "tracking": "0.02em" },
      "mono": { "size": "14px", "weight": 500, "lineHeight": 1.4, "tracking": "0.01em", "use": "USDC amounts, escrow IDs, ledger figures" }
    }
  },
  "spacing": {
    "unit": 8,
    "scalePx": [0, 4, 8, 12, 16, 24, 32, 40, 48, 64, 80, 96]
  },
  "layout": {
    "maxContent": "1152px",
    "maxReadable": "640px",
    "maxNarrow": "448px",
    "radius": { "sm": "2px", "md": "4px", "lg": "8px" },
    "density": {
      "guest": { "pagePad": 64, "gutter": 48, "rowGap": 24 },
      "ops": { "pagePad": 32, "gutter": 24, "rowGap": 16 }
    }
  },
  "motion": {
    "easeOut": "cubic-bezier(0.22, 1, 0.36, 1)",
    "easeInOut": "cubic-bezier(0.45, 0, 0.55, 1)",
    "easeSoft": "cubic-bezier(0.33, 1, 0.68, 1)",
    "durationMs": {
      "instant": 100,
      "fast": 180,
      "normal": 280,
      "slow": 420,
      "page": 520
    },
    "reducedMotion": "Zero all durations; retain opacity cut if needed for state clarity"
  },
  "mvpSurfaces": [
    "event-create",
    "reserve",
    "usdc-pay-escrow-confirm",
    "attendance-verify",
    "settlement-split-receipt",
    "treasury-glance"
  ],
  "phase2Surfaces": [
    "menu-browsing",
    "waitlist",
    "kitchen-workflow",
    "course-progression",
    "wine-pairing",
    "guest-preferences-crm",
    "allergens-extended",
    "analytics-full",
    "staff-dashboard-rich"
  ]
}
